# Dependencies — restored from package-lock.json by `npm ci`
node_modules/

# Build output — GitHub Pages serves the artifact produced by
# .github/workflows/deploy.yml, never a committed copy of this folder.
/dist/
/dev-dist/

# Logs & caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/
*.tsbuildinfo

# Local, machine-specific tool settings
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
